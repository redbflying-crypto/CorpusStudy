# Copy to .env (git-ignored) and fill in. Never commit .env.

# --- LLM provider ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional override; defaults to the model set in config.py
# CORPUS_LLM_MODEL=claude-opus-5-5

# --- Languages / translations ---
# Answers follow the user's language: en -> KJV, fr -> LSG1910
# CORPUS_DEFAULT_LANGUAGE=en

# --- Theological stance ---
# CORPUS_STANCE=reformed
# CORPUS_SHOW_OTHER_VIEWS=true

# --- Paths (relative to the repo root) ---
# CORPUS_DATA_DIR=data
# CORPUS_KNOWLEDGE_DIR=knowledge
# CORPUS_INDEX_DIR=indexes

# --- API server ---
# CORPUS_API_HOST=127.0.0.1
# CORPUS_API_PORT=8000
